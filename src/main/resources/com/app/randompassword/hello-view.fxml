<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.app.randompassword.controllers.PasswordController"
      stylesheets="@Style.css"
      spacing="15" alignment="TOP_CENTER" prefWidth="680" prefHeight="480">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <children>
        <Label text="🔐 Générateur de Mots de Passe Sécurisé" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <!-- Formulaire Génération -->
        <HBox spacing="10" alignment="CENTER">
            <children>
                <Label text="Nom / Application:"/>
                <TextField fx:id="nameField" promptText="ex: Compte GitHub" prefWidth="220"/>
                <Button text="Générer" onAction="#generatePassword" styleClass="btn-primary"/>
            </children>
        </HBox>

        <!-- Mot de passe généré -->
        <TextArea fx:id="passwordArea" prefRowCount="1" editable="false" promptText="Le mot de passe apparaît ici..." prefWidth="400" style="-fx-font-family: monospace; -fx-font-size: 14px;"/>

        <!-- Historique -->
        <TableView fx:id="tableView" prefHeight="220" prefWidth="640">
            <columns>
                <TableColumn fx:id="nameColumn" text="Nom / Application" prefWidth="220"/>
                <TableColumn fx:id="passwordColumn" text="Mot de passe" prefWidth="240"/>
                <TableColumn fx:id="availableColumn" text="Statut" prefWidth="160"/>
            </columns>
        </TableView>

        <!-- Action Copier -->
        <Button text="📋 Copier le mot de passe sélectionné (Unique)" onAction="#copyPassword" styleClass="btn-success"/>
    </children>
</VBox>